# Copy to .env on the VPS and set both values before deploying.
THETISLINK_RELAY_TOKEN=change-this-long-random-token
# Your DuckDNS subdomain that points to this VPS, e.g. your-relay.duckdns.org
RELAY_DOMAIN=your-subdomain.duckdns.org
RUST_LOG=info
# Optional: the chat and problem reports beside the relay. It needs the source of
# thetislink-chat next to thetislink-relay (clone the repository; the relay source
# package alone does not have it). Uncomment both lines and choose a long random key.
# COMPOSE_PROFILES=chat
# THETISLINK_CHAT_KEYS=change-this-long-random-key
