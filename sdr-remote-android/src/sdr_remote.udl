interface SdrBridge {
    constructor(boolean relay_enabled, string relay_url, string relay_station, string relay_token, string relay_instance, string relay_name, boolean relay_udp_enabled);
    void connect(string addr, string password);
    void send_totp_code(string code);
    void disconnect();
    void set_language(string lang);
    void chat_dismiss_answer(i64 id);
    sequence<i64> chat_seen_ids();
    void chat_restore_seen(sequence<i64> ids);
    void set_ptt(boolean active);
    void set_roger_beep(BridgeRogerBeep beep);
    void set_mic_gate_delay_ms(u32 delay_ms);
    void set_playback_mute(boolean mute);
    void set_dx_spots_enabled(boolean enabled);
    void set_rx_volume(f32 volume);
    void set_vfo_a_volume(f32 volume);
    void set_vfo_b_volume(f32 volume);
    void set_local_volume(f32 volume);
    void set_tx_gain(f32 gain);
    void set_frequency(u64 hz);
    void set_mode(u8 mode);
    void set_control(u8 control_id, u16 value);
    void set_agc_enabled(boolean enabled);
    void enable_spectrum(boolean enabled);
    void set_spectrum_fps(u8 fps);
    void set_spectrum_max_bins(u16 bins);
    void set_spectrum_zoom(f32 zoom);
    void set_spectrum_pan(f32 pan);
    void set_amplitec_switch_a(u8 pos);
    void set_amplitec_switch_b(u8 pos);
    void tuner_tune();
    void tuner_abort();
    void spe_operate();
    void spe_tune();
    void spe_antenna();
    void spe_input();
    void spe_power();
    void spe_band_up();
    void spe_band_down();
    void spe_off();
    void spe_power_on();
    void spe_drive_down();
    void spe_drive_up();
    void rf2k_operate(boolean on);
    void rf2k_tune();
    void rf2k_ant1();
    void rf2k_ant2();
    void rf2k_ant3();
    void rf2k_ant4();
    void rf2k_ant_ext();
    void rf2k_error_reset();
    void rf2k_close();
    void rf2k_drive_up();
    void rf2k_drive_down();
    void rf2k_tuner_mode(u8 mode);
    void rf2k_tuner_bypass(boolean on);
    void rf2k_tuner_reset();
    void rf2k_tuner_store();
    void rf2k_tuner_l_up();
    void rf2k_tuner_l_down();
    void rf2k_tuner_c_up();
    void rf2k_tuner_c_down();
    void rf2k_tuner_k();
    void ub_retract();
    void ub_set_frequency(u16 khz, u8 direction);
    void ub_read_elements();
    void rotor_goto(u16 angle_x10);
    void rotor_stop();
    void rotor_cw();
    void rotor_ccw();
    void yaesu_enable(boolean on);
    void yaesu_power_on_off(boolean on);
    void yaesu2_power_on_off(boolean on);
    void yaesu_read_memories();
    void yaesu_ptt(boolean on);
    void yaesu_volume(f32 vol);
    void yaesu_select_vfo(u8 vfo);
    void yaesu_recall_memory(u16 channel);
    void yaesu_freq(u64 hz);
    void yaesu_mode(u8 mode);
    void yaesu_button(u16 button_id);
    void yaesu_tx_gain(f32 gain);
    void yaesu_eq_band(u8 band, f32 gain_db);
    void yaesu_eq_enabled(boolean on);
    void yaesu_compressor(u8 level);
    void yaesu_tx_agc(boolean on);
    void yaesu2_compressor(u8 level);
    void yaesu2_tx_agc(boolean on);
    void yaesu_control(u8 slot, u8 control, u16 value);
    void yaesu2_enable(boolean on);
    void yaesu2_read_memories();
    void yaesu2_ptt(boolean on);
    void yaesu2_volume(f32 vol);
    void yaesu2_select_vfo(u8 vfo);
    void yaesu2_recall_memory(u16 channel);
    void yaesu2_freq(u64 hz);
    void yaesu2_mode(u8 mode);
    void yaesu2_button(u16 button_id);
    void yaesu2_tx_gain(f32 gain);
    void yaesu2_eq_band(u8 band, f32 gain_db);
    void yaesu2_eq_enabled(boolean on);
    void server_reboot();
    void server_shutdown();
    BridgeChatState chat_state(boolean open);
    void chat_consent(string display_name);
    void chat_send(string body, i64 reply_to);
    void chat_edit(i64 id, string body);
    void chat_leave(boolean delete_messages);
    void chat_mark_read();
    string chat_build_attachment(string log, string settings);
    void chat_report(string note, string attachment);
    BridgeRadioState get_state();
    void shutdown();
};
